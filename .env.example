# Morpho GraphQL API. Both optional: without them the app uses the public, keyless endpoint
# (https://api.morpho.org/graphql). Set them to point at a dedicated API instance; the key is
# sent as an `x-api-key` header.
MORPHO_API_URL=
MORPHO_API_KEY=

NEXT_PUBLIC_URL=

# Get this from https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Required for ALL deployments, even ones that don't serve mainnet vaults or markets: the OFAC
# sanctions screening reads Chainalysis's on-chain oracle on mainnet and fails closed, so without
# a mainnet RPC every transaction flow is blocked.
MAINNET_RPC_URL_1=
MAINNET_RPC_URL_2=

BASE_RPC_URL_1=
BASE_RPC_URL_2=

POLYGON_RPC_URL_1=
POLYGON_RPC_URL_2=

UNICHAIN_RPC_URL_1=
UNICHAIN_RPC_URL_2=

KATANA_RPC_URL_1=
KATANA_RPC_URL_2=

ARBITRUM_RPC_URL_1=
ARBITRUM_RPC_URL_2=

WORLDCHAIN_RPC_URL_1=
WORLDCHAIN_RPC_URL_2=

HYPEREVM_RPC_URL_1=
HYPEREVM_RPC_URL_2=

NEXT_TELEMETRY_DISABLED=1
